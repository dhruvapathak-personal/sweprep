{
  "name": "SWE Trainer",
  "build": { "dockerfile": "Dockerfile", "target": "app" },
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "workspaceFolder": "/workspace/sweprep",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/sweprep,type=bind",
  "forwardPorts": [3000],
  "postCreateCommand": "npm ci",
  "runArgs": ["--init", "--network=host"],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "github.vscode-github-actions",
        "ms-vscode-remote.remote-containers"
      ]
    }
  }
}
