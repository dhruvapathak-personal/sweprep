{
  "name": "SWE Trainer · dev",
  "build": {
    "dockerfile": "../Dockerfile",
    "target": "dev"
  },
  "remoteUser": "dhruva",
  "updateRemoteUserUID": true,
  "workspaceFolder": "/workspace/sweprep",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/sweprep,type=bind",
  "forwardPorts": [ 3000 ],
  "appPort": [ "127.0.0.1:3000:3000" ],
  "postCreateCommand": "npm ci",
  "runArgs": [
    "--init",
    "--network=bridge",
    "--userns=keep-id:uid=1000,gid=1000"
  ],
  "remoteEnv": {
    "SSH_AUTH_SOCK": "${localEnv:SSH_AUTH_SOCK}",
    "HOST_SSH_AUTH_SOCK": "${localEnv:SSH_AUTH_SOCK}"
  },
  "mounts": [
    "source=${localEnv:SSH_AUTH_SOCK},target=${localEnv:SSH_AUTH_SOCK},type=bind",
    "source=sweprep-editor-state,target=/home/dhruva/.vscode-server,type=volume",
    "source=sweprep-copilot-state,target=/home/dhruva/.copilot,type=volume",
    "source=sweprep-codex-state,target=/home/dhruva/.codex,type=volume"
  ]
}
