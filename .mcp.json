{
	"mcpServers": {
		"supabase": {
			"type": "http",
			"url": "https://mcp.supabase.com/mcp?read_only=true"
		},
		"filesystem": {
			"type": "stdio",
			"command": "/opt/devcontainer-mcp/npm/bin/mcp-server-filesystem",
			"args": [
				"/workspace/sweprep"
			],
			"tools": [
				"*"
			]
		},
		"container": {
			"type": "stdio",
			"command": "/opt/devcontainer-mcp/npm/bin/podman-mcp-server",
			"args": [],
			"tools": [
				"*"
			],
			"env": {
				"CONTAINER_HOST": "unix:///run/podman/podman.sock"
			}
		},
		"git": {
			"type": "stdio",
			"command": "/opt/devcontainer-mcp/git-venv/bin/python",
			"args": [
				"-m",
				"mcp_server_git",
				"--repository",
				"/workspace/sweprep"
			],
			"tools": [
				"*"
			]
		},
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/",
			"tools": [
				"*"
			]
		},
		"graphify": {
			"type": "stdio",
			"command": "/opt/devcontainer-mcp/graphify-venv/bin/graphify-mcp",
			"args": [
				"/workspace/sweprep/graphify-out/graph.json"
			],
			"tools": [
				"*"
			]
		},
		"playwright": {
			"type": "stdio",
			"command": "/opt/devcontainer-mcp/npm/bin/playwright-mcp",
			"args": [
				"--browser",
				"chromium"
			],
			"tools": [
				"*"
			]
		}
	}
}
